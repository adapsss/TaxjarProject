# Copy to .env to change these for your machine (docker compose reads .env).

# Host ports: the live app and the simulator.
APP_PORT=8080
SIMULATOR_PORT=8081

# Postgres. Change the password for anything but a laptop.
POSTGRES_USER=taxjar
POSTGRES_PASSWORD=taxjar
POSTGRES_DB=taxjar
# Host port for local tools and the backend test suite (bound to 127.0.0.1 only).
DB_PORT=5433

# Backend. DEMO_MODE=false removes the reset, simulator and demo-scenario routes.
DEMO_MODE=true
# Seconds the backend keeps tax data in memory before re-reading it (rates edited in SQL show up after this).
TAX_DATA_REFRESH_SECONDS=60

# Optional backend log level: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
