# Gateway: one port per app, any hostname (point the names at 127.0.0.1 in /etc/hosts).
#
#   :80 in the container (APP_PORT on the host, default 8080)        the live app
#   :81 in the container (SIMULATOR_PORT on the host, default 8081)  a shortcut: redirects to the simulator on the app's port
#
# Both talk to the same backend, so payments sent from the simulator show up live
# in the app over the event stream (/api/events).

{
	auto_https off
	admin off
	# Every Caddy log (access and error, e.g. a reverse_proxy warning when a live event stream
	# disconnects) can include the request headers. Behind the AWS load balancer they carry the
	# Cognito session (X-Amzn-Oidc-*), so those and the usual credentials are removed from all logs.
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Amzn-Oidc-Accesstoken delete
				request>headers>X-Amzn-Oidc-Data delete
				request>headers>X-Amzn-Oidc-Identity delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

(taxjar) {
	# Basic hardening: no MIME sniffing, no framing, no full referrer to other sites; small request bodies.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 1MB
	}
	# The API, the event stream and the backend's API docs go to FastAPI.
	# No `encode` here: compressing would buffer the event stream.
	@backend path /api/* /docs /docs/* /openapi.json
	handle @backend {
		# BACKEND_UPSTREAM (default backend:8000): the backend's host:port, e.g. the Kubernetes Service.
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	# Everything else is the single-page app.
	handle {
		root * /srv/www
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

:80 {
	import taxjar
}

:81 {
	# The simulator lives on the app's own origin, so the two tabs can talk to each other
	# (the app keeps the simulator's demo-setup payments quiet). This port is a shortcut to it.
	redir http://{host}:{$APP_PORT:8080}/simulator
}
